# Backend Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.

# ─── Django Core ──────────────────────────────────────────────────────────────

# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-before-production

# Set to False in production
DJANGO_DEBUG=True

# Space-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Space-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# ─── Cloudflare D1 ────────────────────────────────────────────────────────────

# Cloudflare account ID
CLOUDFLARE_ACCOUNT_ID=

# D1 database ID (from Cloudflare dashboard)
CLOUDFLARE_D1_DATABASE_ID=

# Cloudflare API token with D1 read/write permissions
CLOUDFLARE_API_TOKEN=

# ─── Cloudflare R2 (media storage) ───────────────────────────────────────────

CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# ─── Email ────────────────────────────────────────────────────────────────────

# Use "django.core.mail.backends.console.EmailBackend" for development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hsjb.info

# ─── JWT Auth ─────────────────────────────────────────────────────────────────

JWT_SECRET_KEY=change-me-before-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Redis (required in production for Django Channels) ───────────────────────

REDIS_URL=redis://localhost:6379/0
